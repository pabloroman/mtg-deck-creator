{
  "name": "mtg-deck-creator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browse and filter an MTG collection by Scryfall oracle tags and color.",
  "scripts": {
    "preprocess": "tsx scripts/preprocess.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "build:gh": "DEPLOY_TARGET=gh-pages npm run build",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/stream-json": "^1.7.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "papaparse": "^5.4.1",
    "postcss": "^8.4.49",
    "stream-chain": "^2.2.5",
    "stream-json": "^1.8.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
